{
  "name": "lecture-room-booking",
  "version": "1.0.0",
  "description": "Lecture Room Booking System: find free rooms, book without clashes, approve student requests.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:rooms": "node src/db/seed.js --no-demo",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
