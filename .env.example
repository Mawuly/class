# Set these in Vercel → Project → Settings → Environment Variables. Nothing needs to run locally.

# Supabase → Connect → "Transaction pooler" (port 6543). Not needed if you connected Supabase
# through Vercel → Storage, which sets POSTGRES_URL for you.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Your email: registering with it makes you the admin. Comma-separate several.
ADMIN_EMAILS=

# Optional: "true" fills an empty database with demo lecturers, a demo student and bookings.
SEED_DEMO=

# Optional: only allow sign-ups from this email domain, e.g. ug.edu.gh
ALLOWED_EMAIL_DOMAIN=

# Optional: long random string for signing logins (derived from the database URL if unset).
JWT_SECRET=

# Optional: Supabase's CA certificate (Database settings → SSL) to verify TLS.
DATABASE_CA=

# Optional: email for password reset codes. Without these, "Forgot password" goes through the
# timetable office. Gmail: smtp.gmail.com, 587, the address, and a 16-letter App password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
