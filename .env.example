# Copy to .env.local for reference; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" (port 6543). Used by the app on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional: only allow sign-ups from this email domain, e.g. ug.edu.gh
ALLOWED_EMAIL_DOMAIN=

# Optional: contents of Supabase's CA certificate (Database settings → SSL) to verify TLS.
DATABASE_CA=
